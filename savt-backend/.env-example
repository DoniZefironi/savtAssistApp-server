# ВАЖНО (прод): пароль БД и JWT-секрет должны быть длинными и случайными.
# Сгенерировать: openssl rand -hex 48
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/savt
APP_ENV=dev

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

POSTGRES_DB=savt

# Минимум 64 случайных символа! Сгенерировать: openssl rand -hex 48
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=60

SMS_CODE_TTL_MINUTES=10
SMS_CODE_MAX_ATTEMPTS=5
SMS_CODE_RESEND_COOLDOWN_SECONDS=60

# Доставка кода подтверждения телефона — Telegram-бот (пусто = mock-режим, код только в логах).
# Viber удалён: подтвердить владение номером через него нечем — аналога
# Telegram request_contact у Viber нет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

MESSENGER_LINK_REQUEST_TTL_MINUTES=15

# CORS: через запятую, например: https://admin.example.com,http://localhost:3000
# Для разработки можно поставить *
CORS_ORIGINS=*

# Firebase (пуш-уведомления)
FIREBASE_CREDENTIALS_PATH=/code/firebase-credentials.json

# Подпись ссылок на файлы в /static/ (nginx secure_link).
# ОБЯЗАТЕЛЬНО на стенде: конфиг nginx проверяет подпись, и при пустом секрете
# все файлы будут отдавать 403. Значение подставляется и в api, и в nginx
# (см. docker-compose.yml) — источник один, разъехаться не могут.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
STATIC_LINK_SECRET=change_me_to_a_long_random_secret
# Срок жизни ссылки в ответах API (сутки) и в комментариях Bitrix (90 дней)
STATIC_LINK_TTL_SECONDS=86400
STATIC_LINK_EXTERNAL_TTL_SECONDS=7776000

# Яндекс Cloud (для бота Ася)
YANDEX_FOLDER_ID=your_folder_id
YANDEX_API_KEY=your_api_key
YANDEX_GPT_MODEL=yandexgpt-lite

# Yandex Object Storage — голосовые >1 МБ + офсайт-копии бэкапов БД
YANDEX_STORAGE_BUCKET=
YANDEX_STORAGE_ACCESS_KEY_ID=
YANDEX_STORAGE_SECRET_ACCESS_KEY=
YANDEX_STORAGE_ENDPOINT_URL=https://storage.yandexcloud.net

# Бот
BOT_FOLLOW_UP_MINUTES=60
BOT_MAX_ATTEMPTS=3

# Bitrix24
BITRIX_WEBHOOK_URL=
BITRIX_DEFAULT_RESPONSIBLE_ID=0
BITRIX_DEFAULT_GROUP_ID=0
BITRIX_DEFAULT_CREATOR_ID=0
BITRIX_INCOMING_WEBHOOK_TOKENS=

# Годы производства через запятую (25,26,27). Пусто = импортируются сделки за все годы.
# Номер проекта всегда начинается с двух цифр года: "26_138". Ограничивать имеет
# смысл перед разовым импортом (python -m app.cli import-bitrix-deals), чтобы
# не затянуть весь архив портала.
BITRIX_PRODUCTION_YEARS=

# Коды пользовательских полей сделки — свои у каждого портала.
# Найти: см. README, раздел про поля сделки (crm.deal.fields).
# Номер в производство. Пусто = номер берётся из названия сделки, как раньше
BITRIX_FIELD_PRODUCTION_NUMBER=
# Планируемая дата отгрузки
BITRIX_FIELD_SHIPMENT_PLANNED=
# Фактическая дата отгрузки. Можно перечислить несколько кодов через запятую —
# берётся первое непустое (нужно на время переезда со старого поля на новое)
BITRIX_FIELD_SHIPMENT_ACTUAL=
# Название сделки должно начинаться ровно с этого префикса + "_", иначе номер не засчитывается
BITRIX_PRODUCTION_NUMBER_PREFIX=26

# Папки проектов на NAS (CIFS-том, см. docker-compose.yml). Пусто в PROJECT_FOLDERS_ROOT
# отключает создание папок совсем — остальные три переменные нужны только докеру для монтирования.
PROJECT_FOLDERS_ROOT=/mnt/projects
NAS_SHARE_DEVICE=//XPEnologySAVT/Share/-= Производство =-/!2026
NAS_SHARE_USER=
NAS_SHARE_PASSWORD=

# Обратимое шифрование номера проекта из Bitrix в unique_code (Fernet)
# Сгенерировать ключ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BITRIX_PROJECT_CODE_KEY=
BITRIX_PROJECT_CODE_PEPPER=3.1415
